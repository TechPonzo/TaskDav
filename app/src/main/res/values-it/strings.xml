    <string name="onboarding_welcome_title">Benvenuto in TaskDav</string>
    <string name="onboarding_welcome_body">Attività, calendario e note — sul telefono o sincronizzati con il tuo server CalDAV. Nessun Google Play Services.</string>
    <string name="onboarding_welcome_pick_language">Scegli una lingua</string>

    <string name="onboarding_sync_title">Prima di tutto tuoi</string>
    <string name="onboarding_sync_body">Resta solo su questo dispositivo, oppure collega lo stesso server CalDAV che usi già con DAVx⁵. Puoi cambiare quando vuoi in Impostazioni.</string>

    <string name="onboarding_tasks_title">Attività annidate</string>
    <string name="onboarding_tasks_body">Organizza con cartelle di categorie annidabili, sottoattività, scadenze, tag e riordino fluido. Tutto funziona anche offline.</string>

    <string name="onboarding_calendar_title">Calendario su misura</string>
    <string name="onboarding_calendar_body">Viste giorno, settimana e mese per i tuoi eventi. Opzionalmente condividili con l’app Calendario del telefono — senza DAVx⁵ in modalità locale.</string>

    <string name="onboarding_notes_title">Note accanto</string>
    <string name="onboarding_notes_body">Cattura idee come note con tag. Si sincronizzano come VJOURNAL con CalDAV e restano sul dispositivo se resti in locale.</string>

    <string name="onboarding_ready_title">Pronto quando lo sei tu</string>
    <string name="onboarding_ready_body">Configuriamo l’archiviazione sul dispositivo così puoi iniziare subito. Collega CalDAV più tardi da Impostazioni → Sincronizzazione.</string>

