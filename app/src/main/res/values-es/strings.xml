    <string name="onboarding_welcome_title">Bienvenido a TaskDav</string>
    <string name="onboarding_welcome_body">Tareas, calendario y notas — en tu teléfono o sincronizados con tu servidor CalDAV. Sin Google Play Services.</string>
    <string name="onboarding_welcome_pick_language">Elige un idioma</string>

    <string name="onboarding_sync_title">Lo tuyo primero</string>
    <string name="onboarding_sync_body">Quédate solo en este dispositivo, o conecta el mismo servidor CalDAV que ya usas con DAVx⁵. Cámbialo cuando quieras en Ajustes.</string>

    <string name="onboarding_tasks_title">Tareas que anidan</string>
    <string name="onboarding_tasks_body">Organiza con carpetas de categorías anidables, subtareas, fechas, etiquetas y reordenación suave. Todo funciona sin conexión.</string>

    <string name="onboarding_calendar_title">Calendario a tu medida</string>
    <string name="onboarding_calendar_body">Vistas de día, semana y mes para tus eventos. Opcionalmente compártelos con la app Calendario del teléfono — sin DAVx⁵ si usas solo local.</string>

    <string name="onboarding_notes_title">Notas al lado</string>
    <string name="onboarding_notes_body">Guarda ideas como notas con etiquetas. Se sincronizan como VJOURNAL con CalDAV, y viven en el dispositivo si te quedas en local.</string>

    <string name="onboarding_ready_title">Listo cuando tú lo estés</string>
    <string name="onboarding_ready_body">Configuraremos el almacenamiento en el dispositivo para que empieces ya. Conecta CalDAV más tarde en Ajustes → Sincronización.</string>

