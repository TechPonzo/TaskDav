    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to TaskDav</string>
    <string name="onboarding_welcome_body">Tasks, calendar, and notes — on your phone or synced to your CalDAV server. No Google Play Services required.</string>
    <string name="onboarding_welcome_pick_language">Pick a language</string>

    <string name="onboarding_sync_title">Yours first</string>
    <string name="onboarding_sync_body">Stay local-only on this device, or connect the same CalDAV server you already use with DAVx⁵. Switch anytime in Settings.</string>

    <string name="onboarding_tasks_title">Tasks that nest</string>
    <string name="onboarding_tasks_body">Organize with nestable category folders, subtasks, due dates, tags, and smooth reordering. Everything stays offline-first.</string>

    <string name="onboarding_calendar_title">Calendar that fits</string>
    <string name="onboarding_calendar_body">Day, week, and month views for your events. Optionally share with the phone Calendar app — no DAVx⁵ required for local use.</string>

    <string name="onboarding_notes_title">Notes alongside</string>
    <string name="onboarding_notes_body">Capture ideas as notes with tags. They sync as VJOURNAL when you use CalDAV, and live on-device when you stay local.</string>

    <string name="onboarding_ready_title">Ready when you are</string>
    <string name="onboarding_ready_body">We’ll set up on-device storage so you can start right away. Connect CalDAV later from Settings → Syncing.</string>

